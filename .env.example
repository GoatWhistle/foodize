RUN__HOST=0.0.0.0
RUN__PORT=8000

POSTGRES_DB=foodize
POSTGRES_USER=foodize_user
POSTGRES_PASSWORD=change_me

DB__URL=postgresql+asyncpg://foodize_user:change_me@pg:5432/foodize
DB__ECHO=false
DB__ECHO_POOL=false
DB__POOL_SIZE=50
DB__MAX_OVERFLOW=10

REDIS__URL=redis://redis:6379/0

RABBITMQ_USER=guest
RABBITMQ_PASS=change_me
RABBITMQ__URL=amqp://guest:change_me@rabbitmq:5672/

LOGS__LEVEL=INFO

CORS__ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

AUTH__ACCESS_TOKEN_LIFETIME_SECONDS=1800
AUTH__REFRESH_TOKEN_LIFETIME_SECONDS=2592000
