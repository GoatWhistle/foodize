RUN__HOST=0.0.0.0
RUN__PORT=8000

# Pinned base image tags shared by docker-compose.yaml and docker-compose.prod.yaml.
# Override here to bump a version in one place instead of editing both compose files.
# PGVECTOR_IMAGE_TAG — образ основной БД (pgvector/pgvector, Debian-based);
# POSTGRES_IMAGE_TAG остаётся для pg-backup (pg_dump той же мажорной версии).
PGVECTOR_IMAGE_TAG=pg17
POSTGRES_IMAGE_TAG=17-alpine
RABBITMQ_IMAGE_TAG=4-management-alpine
REDIS_IMAGE_TAG=7.4-alpine

POSTGRES_DB=foodize
POSTGRES_USER=foodize_user
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

DB__URL=postgresql+asyncpg://foodize_user:<CHANGE_ME_STRONG_PASSWORD>@pg:5432/foodize
DB__ECHO=false
DB__ECHO_POOL=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=10

# NOTE: docker compose does NOT interpolate ${VAR} references *inside* an env_file —
# those lines are passed to the container verbatim. Always write the final value
# explicitly here (do not reference other keys with ${...}).
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
REDIS__URL=redis://:<CHANGE_ME_STRONG_PASSWORD>@redis:6379/0

RABBITMQ_USER=foodize
RABBITMQ_PASS=<CHANGE_ME_STRONG_PASSWORD>
RABBITMQ__URL=amqp://foodize:<CHANGE_ME_STRONG_PASSWORD>@rabbitmq:5672/foodize
RABBITMQ_VHOST=foodize

# Required for docker-compose.monitoring.yml (Grafana admin login).
# Avoid the default "admin" username (CIS hardening): pick a non-obvious operator name.
GRAFANA_ADMIN_USER=<CHANGE_ME_GRAFANA_ADMIN_USER>
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
# Prometheus TSDB retention (default 30d instead of the implicit 15d).
PROMETHEUS_RETENTION_TIME=30d

LOGS__LEVEL=INFO
LOGS__SENTRY_DSN=
LOGS__ENVIRONMENT=development

# Debug mode: relaxes production-only guards (e.g. the Redis password check).
# Keep true for local dev, false in production.
DEBUG=false

CORS__ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Trusted proxy IPs for X-Forwarded-For (Uvicorn --forwarded-allow-ips).
# Only these sources may set the client IP used by rate limiting. Default covers
# the Docker bridge subnet (the frontend nginx container that proxies /api/v1 to
# backend). NEVER set to "*" in production — it lets clients spoof X-Forwarded-For
# and bypass rate limits.
FORWARDED_ALLOW_IPS=172.16.0.0/12

AUTH__ACCESS_TOKEN_LIFETIME_SECONDS=1800
AUTH__REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# Telegram Bot (получить токен у @BotFather)
BOT_TOKEN=
MINI_APP_URL=
BOT_USERNAME=
TELEGRAM__BOT_API_SECRET=<CHANGE_ME_GENERATE_RANDOM_SECRET>
BOT_MODE=polling
# Для webhook-режима:
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Backend Telegram config (write final values explicitly — see REDIS note above)
TELEGRAM__BOT_TOKEN=
TELEGRAM__MINI_APP_URL=
TELEGRAM__BOT_USERNAME=

# Frontend build-time URLs for QR/share links
VITE_WEB_URL=http://localhost:5173
VITE_MINI_APP_URL=
VITE_BOT_USERNAME=

# ── LLM provider (AI advisor + order agent) ────────────────────────────────
# Pick ONE provider via LLM__PROVIDER. OpenRouter is OpenAI-compatible.
LLM__PROVIDER=openai
LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM__OPENAI_MODEL=cohere/north-mini-code:free
# Anthropic (direct): LLM__PROVIDER=anthropic, LLM__ANTHROPIC_API_KEY=sk-ant-...
# Ollama (local):     LLM__PROVIDER=ollama,  LLM__OLLAMA_MODEL=qwen2.5

# Embeddings for semantic menu search — local Ollama bge-m3 (`ollama pull bge-m3`).
# If unreachable, search falls back to keyword matching automatically.
LLM__EMBEDDINGS_ENABLED=true
LLM__EMBEDDING_BASE_URL=http://localhost:11434/v1
LLM__EMBEDDING_MODEL=bge-m3

# ── Object storage (S3 / MinIO) for dish photos ────────────────────────────
# Local dev uses the bundled MinIO container. For prod use a real S3-compatible
# bucket: set S3__ENDPOINT_URL to your provider (or leave empty for AWS S3),
# S3__PUBLIC_BASE_URL to the public/CDN base, and real credentials. The bucket
# must allow public read of objects.
S3_ACCESS_KEY=<CHANGE_ME_MINIO_OR_S3_ACCESS_KEY>
S3_SECRET_KEY=<CHANGE_ME_MINIO_OR_S3_SECRET>
S3_BUCKET=foodize-media
S3__ENDPOINT_URL=http://minio:9000
S3__PUBLIC_BASE_URL=http://localhost:9000/foodize-media

# ── Native push (APNs / FCM) for mobile order-status delivery ──────────────
# All optional. Leave unset to keep native push disabled (no-op, no failures).
# iOS via APNs token auth (.p8 key). Requires the h2 extra for HTTP/2 delivery.
# PUSH__APNS_KEY=<CONTENTS_OF_AuthKey_XXXX.p8>
# PUSH__APNS_KEY_ID=<10_CHAR_KEY_ID>
# PUSH__APNS_TEAM_ID=<10_CHAR_TEAM_ID>
# PUSH__APNS_TOPIC=<APP_BUNDLE_ID>
# PUSH__APNS_USE_SANDBOX=false
# Android / Web via FCM legacy server key.
# PUSH__FCM_SERVER_KEY=<FCM_SERVER_KEY>
