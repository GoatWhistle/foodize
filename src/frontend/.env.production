# Build-time config for the production web build (Vite loads this automatically
# on `npm run build`). Only VITE_* vars are exposed to the client bundle.

# Relative path so the browser hits the same origin; the frontend nginx proxies
# /api/v1 -> backend. Do NOT point this at localhost or a hardcoded host.
VITE_API_URL=/api/v1

# Public site URL used for QR/share links. Leave empty to fall back to the
# current origin (window.location.origin) at runtime, or set it to your domain,
# e.g. https://example.com
VITE_WEB_URL=

# Telegram bot username (без @) для QR-ссылок в бота. Держи в синхроне с BOT_USERNAME в .env
VITE_BOT_USERNAME=FoodizeBot

# Mini App не деплоится в режиме «только web» — оставь пустым
VITE_MINI_APP_URL=
