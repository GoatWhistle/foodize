# Production build with the monorepo build context set to ./src so that the
# shared package (src/shared) is available inside the image. The Vite alias
# `@shared` resolves to `path.resolve(__dirname, '../shared')`, i.e. `/shared`
# when the app lives in `/frontend` — so shared code must be copied to /shared.
FROM node:20-alpine AS build-stage
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
# Shared code first (so `../shared` -> /shared resolves), then the app itself.
COPY shared /shared
COPY frontend/ .
RUN npm run build

FROM nginx:1.28-alpine AS production
COPY --from=build-stage /frontend/dist /usr/share/nginx/html
COPY frontend/nginx/default.conf /etc/nginx/conf.d/default.conf
CMD ["nginx", "-g", "daemon off;"]
