# Базовый URL backend API (Foodize). На устройстве/эмуляторе localhost не работает —
# укажите IP машины (например http://192.168.1.10:8000/api/v1) или адрес стенда.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# DSN проекта Sentry для крэш-репортинга (опционально; без него Sentry не инициализируется).
EXPO_PUBLIC_SENTRY_DSN=
